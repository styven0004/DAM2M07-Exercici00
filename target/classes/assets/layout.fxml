<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.Controller">
   <children>
      <TextField fx:id="txtNum1" layoutX="50.0" layoutY="40.0" prefWidth="140.0" promptText="Número 1" />
      <TextField fx:id="txtNum2" layoutX="210.0" layoutY="40.0" prefWidth="140.0" promptText="Número 2" />
      
      <HBox layoutX="50.0" layoutY="100.0" spacing="20.0">
         <children>
            <Button fx:id="btnSuma" onAction="#operar" prefWidth="60.0" text="+" />
            <Button fx:id="btnResta" onAction="#operar" prefWidth="60.0" text="-" />
            <Button fx:id="btnMultiplica" onAction="#operar" prefWidth="60.0" text="*" />
            <Button fx:id="btnDivideix" onAction="#operar" prefWidth="60.0" text="/" />
         </children>
      </HBox>
      
      <Label fx:id="lblResultat" layoutX="50.0" layoutY="180.0" prefWidth="300.0" style="-fx-font-size: 18px; -fx-alignment: center;" text="Resultat: " />
   </children>
</AnchorPane>